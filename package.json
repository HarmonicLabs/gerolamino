{
    "name": "gerolamino",
    "version": "0.2.0-dev.1",
    "private": true,
    "type": "module",
    "description": "Gerolamino: a standalone Cardano node for the browser (Chrome extension), pure TypeScript on the HarmonicLabs libraries, chain stored in OPFS, peers over N2N-over-WebSocket",
    "license": "Apache-2.0",
    "author": "Harmonic Laboratories",
    "scripts": {
        "build": "bun scripts/build.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit -p .",
        "smoke": "bun scripts/node-smoke.ts",
        "ledger-smoke": "bun scripts/ledger-smoke.ts",
        "mithril-tables-smoke": "bun scripts/mithril-tables-smoke.ts",
        "e2e": "bun scripts/e2e-chrome.ts",
        "docs": "bun scripts/docs.ts",
        "docs-serve": "bun scripts/serve-docs.ts"
    },
    "dependencies": {
        "@harmoniclabs/cardano-math-ts": "^0.0.5",
        "@harmoniclabs/cbor": "^1.6.6",
        "@harmoniclabs/crypto": "^0.3.1",
        "@harmoniclabs/cardano-ledger-ts": "file:vendor/harmoniclabs-cardano-ledger-ts-0.6.0.tgz",
        "@harmoniclabs/kes": "file:vendor/harmoniclabs-kes-0.1.0.tgz",
        "@harmoniclabs/ouroboros-miniprotocols-ts": "^0.0.5-dev7",
        "@harmoniclabs/plutus-data": "1.2.6",
        "@harmoniclabs/plutus-machine": "2.1.3",
        "@harmoniclabs/uplc": "1.4.1",
        "@harmoniclabs/uint8array-utils": "^1.0.4",
        "@harmoniclabs/mithril-ts": "file:vendor/harmoniclabs-mithril-ts-0.1.1.tgz"
    },
    "devDependencies": {
        "@types/bun": "^1.4.3",
        "typescript": "^5.9.3"
    }
}
