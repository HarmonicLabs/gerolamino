{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["bun"],
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": false,
        "isolatedModules": true
    },
    "include": ["src", "scripts", "test"]
}
